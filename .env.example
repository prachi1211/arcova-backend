# Server
PORT=3001
NODE_ENV=development

# Supabase — get from your Supabase project dashboard (Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Anthropic — optional, AI chat degrades gracefully without it
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # optional — only needed for webhook verification

# CORS — frontend URL(s), comma-separated for multiple origins
CORS_ORIGIN=http://localhost:5173,https://witharcova.vercel.app
